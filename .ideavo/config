{
  "systemSetup": [
    { "name": "Install pnpm", "command": "npm install -g pnpm" }
  ],
  "templateName": "custom",
  "projectDependencies": [
    { "name": "Install Dependencies", "command": "cd webpage \u0026\u0026 pnpm install" }
  ],
  "codeChecks": [
    { "name": "Lint", "command": "cd webpage \u0026\u0026 pnpm run lint" }
  ],
  "buildSteps": [
    { "name": "Build Project", "command": "cd webpage \u0026\u0026 pnpm run build" }
  ],
  "runStep": [
    { "name": "Run Dev Server", "command": "cd webpage \u0026\u0026 pnpm run dev --port 3000", "port": "3000" }
  ],
  "deploySteps": [
    { "name": "Build for Deploy", "command": "cd webpage \u0026\u0026 pnpm run build" }
  ],
  "cleanupFiles": [
    "webpage/node_modules",
    "webpage/.next",
    "webpage/out",
    "webpage/dist"
  ],
  "packageManager": "pnpm",
  "envPaths": [
    { "name": "default", "path": "webpage/.env" }
  ]
}
